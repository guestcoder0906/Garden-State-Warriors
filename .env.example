# ============================================================================
# GARDEN STATE WARRIORS WEBSITE - ENVIRONMENT VARIABLES (.env.example)
# Developer-only configuration for Vercel Project Settings -> Environment Variables.
# ============================================================================

# 1. GOOGLE SHEETS DYNAMIC AUTO-UPDATE (Verified Roster, Staff, Ranks & Events)
# Web App URL from your Google Sheet -> Extensions -> Apps Script -> Deploy -> Web App
VITE_GOOGLE_APPS_SCRIPT_WEBHOOK_URL="https://script.google.com/macros/s/YOUR_DEPLOYMENT_ID/exec"
# Optional fallback: Spreadsheet ID + Read-Only Google Cloud API Key
VITE_GOOGLE_SPREADSHEET_ID="YOUR_GOOGLE_SHEETS_SPREADSHEET_ID"
VITE_GOOGLE_SHEETS_API_KEY="YOUR_GOOGLE_CLOUD_API_KEY"

# 2. SUPABASE GLOBAL DATABASE (Optional global persistence)
VITE_SUPABASE_URL="https://YOUR_PROJECT_ID.supabase.co"
VITE_SUPABASE_ANON_KEY="YOUR_SUPABASE_PUBLIC_ANON_KEY"
SUPABASE_SERVICE_ROLE_KEY="YOUR_SUPABASE_SERVICE_ROLE_KEY"

# 3. READ-ONLY SOCIAL MEDIA FEED (Reads @njveteranhockey & Facebook 61594324051761)
# Option A (Easiest Read-Only): Public JSON feed URL (e.g. Behold.so or RSS.app JSON feed)
VITE_SOCIAL_FEED_JSON_URL="https://feeds.behold.so/YOUR_READ_ONLY_FEED_ID"
# Option B: Meta Read-Only Access Tokens
VITE_INSTAGRAM_ACCESS_TOKEN="YOUR_INSTAGRAM_READ_ONLY_TOKEN"
VITE_INSTAGRAM_USER_ID="njveteranhockey"
VITE_FACEBOOK_PAGE_ID="61594324051761"
VITE_FACEBOOK_ACCESS_TOKEN="YOUR_FACEBOOK_PAGE_READ_ONLY_TOKEN"

# 4. DONATION & STORE LINKS (Optional 501(c)(3) Checkout & Apparel Links)
VITE_PAYPAL_DONATE_URL="https://www.paypal.com/donate/?hosted_button_id=YOUR_BUTTON_ID"
VITE_STRIPE_DONATE_URL="https://donate.stripe.com/YOUR_STRIPE_LINK"
VITE_TEAM_SHOP_URL="https://YOUR_TEAM_STORE_URL"

# 5. AI STUDIO / RUNTIME ENVIRONMENT
GEMINI_API_KEY="MY_GEMINI_API_KEY"
APP_URL="MY_APP_URL"
